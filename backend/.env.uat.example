# Ganesha Solar CRM API — UAT
# Copy to backend/.env.uat and set DATABASE_URL password + storage keys.

PORT=4001
NODE_ENV=development
APP_ENV=uat

# Shared pooler
# host=aws-0-ap-southeast-2.pooler.supabase.com
# port=5432
# database=postgres
# user=postgres.yfjvvqjznjoxuyhhtfjk
DATABASE_URL=postgresql://postgres.yfjvvqjznjoxuyhhtfjk:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-uat-jwt-secret
JWT_EXPIRES_IN=7d

FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://yfjvvqjznjoxuyhhtfjk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=ganesha_solar

STORAGE_S3_ENDPOINT=https://yfjvvqjznjoxuyhhtfjk.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=ap-southeast-2
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

SEED_ADMIN_NAME=Vishal Wandile
SEED_ADMIN_USERNAME=vishal.wandile
SEED_ADMIN_PASSWORD=admin123
