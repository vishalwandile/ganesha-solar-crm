# Ganesha Solar CRM API — copy to .env and fill in values
PORT=4000
NODE_ENV=development

# Supabase Postgres connection string (Session / Transaction pooler both work)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS — comma-separated, no trailing slash
FRONTEND_ORIGIN=http://localhost:5173,https://ganesha-solar-crm.vercel.app

# Supabase Storage REST fallback (if S3 credentials are unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=ganesha_solar

# Supabase S3-compatible storage. Keep credentials in Render/environment only.
# Replace PROJECT_REF with your Supabase project ref, e.g. abcdefghijklmnopqrst
STORAGE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=ap-northeast-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Seed admin (used by npm run seed)
SEED_ADMIN_NAME=Vishal Wandile
SEED_ADMIN_USERNAME=vishal.wandile
SEED_ADMIN_PASSWORD=admin123

# UAT: copy backend/.env.uat.example to backend/.env.uat
# Then: npm run db:push:uat && npm run db:migrate:uat && npm run seed:uat && npm run dev:uat
